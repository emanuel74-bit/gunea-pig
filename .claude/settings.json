{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm --prefix conventions/scripts run executor -- --route *)",
      "Bash(npm --prefix conventions/scripts run validate:*)",
      "Bash(npm --prefix conventions/scripts run verify:scripts)",
      "Bash(npm --prefix conventions/scripts run claude:*)",
      "Read(conventions/**)",
      "Read(.claude/**)",
      "Read(CLAUDE.md)",
      "Read(.claude/commands/**)",
      "Read(.claude/agents/**)",
      "Read(.claude/skills/**)"
    ],
    "deny": [
      "Bash(npx tsx conventions/scripts/*.ts *)",
      "Bash(node conventions/scripts/*.ts *)",
      "Bash(tsx conventions/scripts/*.ts *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm --prefix conventions/scripts run executor -- --route validate_executor_routes",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "npm --prefix conventions/scripts run executor -- --route validate_references",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "npm --prefix conventions/scripts run executor -- --route validate_runtime_artifacts",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npm --prefix conventions/scripts run executor -- --route validate_changed_files",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm --prefix conventions/scripts run executor -- --route collect_evidence",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "npm --prefix conventions/scripts run executor -- --route validate_report_evidence",
            "timeout": 120
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm --prefix conventions/scripts run executor -- --route collect_evidence",
            "timeout": 120
          }
        ]
      }
    ]
  }
}