# ─── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/gunea-pig

# ─── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ─── S3-Compatible Object Storage ─────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_VIDEOS=videos
S3_BUCKET_SCAN_RESULTS=scan-results

# ─── Staging Service ───────────────────────────────────────────────────────────
STAGING_SCAN_PATH=/mnt/scan-staging
STAGING_CONCURRENCY=5

# ─── VDF Scan Service ─────────────────────────────────────────────────────────
VDF_CLI_PATH=vdf
VDF_SCAN_PATH=/mnt/scan-staging
VDF_BATCH_SIZE=50
VDF_BATCH_CLAIM_TTL_SECONDS=600
VDF_SCAN_INTERVAL_MS=30000
VDF_SCANNER_PROFILE=default
VDF_SCANNER_VERSION=2.0.0
VDF_RESULT_RETENTION_SECONDS=86400

# ─── Grouping Service ─────────────────────────────────────────────────────────
GROUPING_SIMILARITY_STORE_EDGE_SCORE=0.88
GROUPING_SIMILARITY_AUTO_MERGE_SCORE=0.93
GROUPING_SIMILARITY_STRONG_DUPLICATE_SCORE=0.98

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production
